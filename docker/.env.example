# 复制为 docker/.env 后填写；docker/.env 已被 .gitignore 忽略，不会进入版本库。
#
#   cp docker/.env.example docker/.env

# 后台 JWT 签名密钥：至少 32 字节。生成方式：
#   openssl rand -base64 48
ANBOT_SIGNING_KEY=

# 首次启动（账号表为空）时创建的引导管理员。
ANBOT_ADMIN_USER=admin
ANBOT_ADMIN_PASSWORD=

# 可选：OneBot 12 握手令牌。6700 端口对宿主机开放时建议设置。
ANBOT_ONEBOT_TOKEN=

# 可选：容器时区。
TZ=Asia/Shanghai
