<Project Sdk="Microsoft.NET.Sdk">

  <!--
    后台 REST API：以类库形态提供 AddAdminApi() / MapAdminApi()，由宿主（AnBot.Cli）挂载。
    刻意不做成独立 Web 应用——后台必须与机器人共用同一个 DI 容器，才能读到运行中的
    适配器、插件与调度器状态；独立进程里 AddAnBot() 得到的是一个空内核。

    ASP.NET Core 的类型（IEndpointRouteBuilder、认证中间件）来自共享框架引用而非 NuGet 包。
    FrameworkReference 会随 ProjectReference 传递给宿主，因此 Cli 无需重复声明。
  -->
  <PropertyGroup>
    <RootNamespace>AnBot.Admin.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnBot.Admin.Shared\AnBot.Admin.Shared.csproj" />
    <ProjectReference Include="..\AnBot.Admin.Infrastructure\AnBot.Admin.Infrastructure.csproj" />
    <ProjectReference Include="..\AnBot.Core\AnBot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

</Project>
