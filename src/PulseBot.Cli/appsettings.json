{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Permissions": {
    "SuperAdmins": [ "console-user" ]
  },
  "Sessions": {
    "IdleTimeout": "00:30:00",
    "PromptTimeout": "00:05:00",
    "CancelCommands": [ "/cancel" ],
    "CancelMessage": "已取消。",
    "CleanupInterval": "00:05:00"
  },
  "Adapters": {
    "Console": {
      "UserId": "console-user",
      "UserDisplayName": "控制台用户"
    }
  }
}
