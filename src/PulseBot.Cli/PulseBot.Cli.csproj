<Project Sdk="Microsoft.NET.Sdk">

  <!-- 宿主入口：组装 DI 容器，加载适配器与插件。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PulseBot.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PulseBot.Core\PulseBot.Core.csproj" />
    <ProjectReference Include="..\PulseBot.Adapter.Console\PulseBot.Adapter.Console.csproj" />
    <ProjectReference Include="..\PulseBot.Adapter.OneBotV11\PulseBot.Adapter.OneBotV11.csproj" />
    <ProjectReference Include="..\PulseBot.Plugins.Echo\PulseBot.Plugins.Echo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <!--
    配置文件随生成输出复制：普通 SDK 工程不像 Web SDK 那样自动复制 appsettings.json，
    而 Host.CreateApplicationBuilder 的配置根目录是输出目录。
  -->
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
