{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Permissions": {
    "SuperAdmins": [ "console-user" ]
  },
  "Sessions": {
    "IdleTimeout": "00:30:00",
    "PromptTimeout": "00:05:00",
    "CancelCommands": [ "/cancel" ],
    "CancelMessage": "已取消。",
    "CleanupInterval": "00:05:00"
  },
  "Scheduling": {
    "PollInterval": "00:00:01",
    "HistoryCapacity": 200,
    "LockLease": "00:10:00"
  },
  "Adapters": {
    "Console": {
      "UserId": "console-user",
      "UserDisplayName": "控制台用户"
    },
    "OneBot12": {
      "Host": "localhost",
      "Port": 6700,
      "Path": "/onebot/v12/",
      "AccessToken": "",
      "ActionTimeout": "00:00:10"
    },
    // 邮件适配器：把自有 IMAP/SMTP 邮箱接入机器人。默认关闭，填好参数并置 Enabled=true 才生效。
    // 只处理 AllowedSenders / AllowedDomains 中的发件人；两者都为空时适配器拒绝启动。
    // 密码建议用环境变量注入：Adapters__Email__Password=<授权码>。
    "Email": {
      "Enabled": false,
      "ImapHost": "",
      "ImapPort": 993,
      "ImapSecurity": "SslOnConnect",
      "Mailbox": "INBOX",
      "IdleTimeout": "00:00:30",
      "ReconnectDelay": "00:00:15",
      "SmtpHost": "",
      "SmtpPort": 587,
      "SmtpSecurity": "StartTls",
      "UserName": "",
      "Password": "",
      "FromAddress": "",
      "FromDisplayName": "AnBot",
      "Subject": "AnBot",
      "AllowedSenders": [],
      "AllowedDomains": []
    }
  },
  "Admin": {
    // 后台管理：与机器人同进程提供只读监控接口（/admin/api/*）与健康检查（/health）。
    // 设为 false 则完全不挂载：不开端口、不建数据库文件。
    "Enabled": true,
    // 监听地址。对外提供服务时改为 http://0.0.0.0:5187 并置于反向代理与 TLS 之后。
    "Url": "http://localhost:5187",
    // SQLite 数据库文件；相对路径以可执行文件所在目录为基准。
    "DatabasePath": "anbot-admin.db",
    "Auth": {
      // ⚠ 签名密钥：上面这两个值是开发默认值，生产环境必须替换。
      //   用环境变量注入，例如：Admin__Auth__SigningKey=<32 字节以上的随机串>
      //   （生成：openssl rand -base64 48）
      "SigningKey": "dev-only-not-for-production-0123456789abcdef",
      "Issuer": "anbot-admin",
      "Audience": "anbot-admin",
      "AccessTokenLifetime": "00:30:00",
      "RefreshTokenLifetime": "7.00:00:00",
      // ⚠ 引导账号只在「账号表为空」的首次启动时创建，
      //   因此登录后应立即把 BootstrapPassword 从配置里删掉。
      "BootstrapUser": "admin",
      "BootstrapPassword": "anbot-dev"
    },
    // 登录限流：按账号与来源 IP 两个维度独立计数，达到阈值即暂时锁定。
    // 计数在进程内存中，重启清零；后台为单实例部署，无需共享。
    "Throttle": {
      // 失败计数的时间窗口：超出窗口的失败不再累计。
      "FailureWindow": "00:15:00",
      // 单个账号在窗口内允许的失败次数。
      "MaxFailuresPerUser": 5,
      // 单个来源 IP 在窗口内允许的失败次数；应明显大于账号阈值（例如 NAT 后的多个用户）。
      "MaxFailuresPerIp": 20,
      // 触发后的锁定时长。
      "LockoutDuration": "00:15:00"
    }
  }
}
