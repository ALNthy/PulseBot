<Project Sdk="Microsoft.NET.Sdk">

  <!-- 宿主入口：组装 DI 容器，加载适配器与插件。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AnBot.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnBot.Core\AnBot.Core.csproj" />
    <ProjectReference Include="..\AnBot.Adapter.Console\AnBot.Adapter.Console.csproj" />
    <ProjectReference Include="..\AnBot.Adapter.Email\AnBot.Adapter.Email.csproj" />
    <ProjectReference Include="..\AnBot.Adapter.OneBot\AnBot.Adapter.OneBot.csproj" />
    <ProjectReference Include="..\AnBot.Plugins.Echo\AnBot.Plugins.Echo.csproj" />
    <ProjectReference Include="..\AnBot.Admin.Api\AnBot.Admin.Api.csproj" />
    <!--
      只参与构建与发布，不把 WASM 程序集作为编译引用带入宿主：
      前端产物在发布阶段复制到 wwwroot，由 ASP.NET Core 静态文件中间件托管。
    -->
    <ProjectReference Include="..\AnBot.Admin.Web\AnBot.Admin.Web.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!--
    发布宿主时一并发布 Blazor WebAssembly 前端，产物落到输出目录下的 wwwroot。
    开发期不会触发：前端由 dotnet run（项目 src/AnBot.Admin.Web）独立运行。
  -->
  <Target Name="PublishAdminWeb" AfterTargets="Publish">
    <!--
      Blazor WASM 的发布输出自身包含 wwwroot 子目录，因此这里把 PublishDir 设为宿主输出目录，
      前端的静态站点会正好落到 <输出目录>/wwwroot，与 ASP.NET Core 的 WebRootPath 对齐。
    -->
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\AnBot.Admin.Web\AnBot.Admin.Web.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(PublishDir)" />
  </Target>

  <!--
    后台 HTTP 服务：宿主进程内承载 ASP.NET Core 管道。
    后台与机器人必须共用同一个 DI 容器，才能读到运行中的适配器、插件与调度器状态——
    独立进程里 AddAnBot() 得到的是一个空内核，看不到任何真实运行数据。
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    不再单独引用 Microsoft.Extensions.Hosting / Logging.Console：
    ASP.NET Core 共享框架（下面的 FrameworkReference）已包含全部 Microsoft.Extensions.* 组件，
    重复引用会被 NuGet 标记为多余（NU1510）。
  -->

  <!--
    配置文件随生成输出复制：普通 SDK 工程不像 Web SDK 那样自动复制 appsettings.json，
    而 Host.CreateApplicationBuilder 的配置根目录是输出目录。
  -->
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
