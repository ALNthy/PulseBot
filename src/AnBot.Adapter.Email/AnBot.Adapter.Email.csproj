<Project Sdk="Microsoft.NET.Sdk">

  <!--
    邮件适配器：把自有 IMAP/SMTP 邮箱接入 AnBot。
    与其他适配器并列，只依赖 Core 的公开契约；收件用 IMAP IDLE，发件用 SMTP。
  -->
  <PropertyGroup>
    <RootNamespace>AnBot.Adapter.Email</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnBot.Core\AnBot.Core.csproj" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="MimeKit" />
  </ItemGroup>

</Project>
