<Project>

  <!--
    中央包版本管理（CPM）：所有 NuGet 包版本集中在此声明，
    各 csproj 只写 <PackageReference Include="..." /> 不带 Version，
    避免版本在多个工程间漂移。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="调度">
    <!--
      Cron 表达式解析。选它而不是自研解析器：步长、区间、列表、DST 与日/周字段的 OR 语义
      边界极多，自研代码的出错概率远高于引入一个零依赖的纯托管库。
      固定 0.11.1：0.x 语义下不写浮动范围，升级需人工验证。
    -->
    <PackageVersion Include="Cronos" Version="0.11.1" />
  </ItemGroup>

  <ItemGroup Label="数据访问">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="后台管理">
    <!--
      JWT 签发与校验。版本号跟随 ASP.NET Core 共享框架（10.0.0），
      不要与 Microsoft.Extensions.* 的版本混用不同大版本。
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <!--
      JWT 的签发与校验原语（JsonWebTokenHandler、TokenValidationParameters 等）。
      JwtBearer 只是把它作为传递依赖带进 Api 项目，而后台基础设施要在编译期直接使用，
      因此显式声明。版本与 JwtBearer 10.0.0 所传递的版本严格一致，避免版本提升。
    -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup Label="邮件适配器">
    <!--
      IMAP / SMTP / MIME 解析。.NET BCL 没有 IMAP 客户端，System.Net.Mail.SmtpClient
      也已不被推荐用于新开发，因此引入 MailKit；MimeKit 是它的消息模型依赖，二者版本同步发布。
      直接使用 MimeKit 类型（MimeMessage、MailboxAddress 等），故显式声明而不是依赖传递引用。
    -->
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <PackageVersion Include="MimeKit" Version="4.18.1" />
  </ItemGroup>

  <ItemGroup Label="前端">
    <!--
      Blazor WebAssembly 宿主与开发服务器，版本跟随 SDK（10.0.1）。
      DevServer 只用于 `dotnet run` 开发联调，发布产物不包含它。
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.1" />
    <!-- 路由授权（AuthorizeRouteView / AuthenticationStateProvider）。 -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.1" />
    <!-- 后台管理界面的组件库。 -->
    <PackageVersion Include="MudBlazor" Version="9.12.0" />
    <!-- 浏览器端的 SignalR 客户端：接收日志、事件与状态推送。 -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <!-- IHttpClientFactory：统一管理 HttpClient 与消息处理器生命周期。 -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="测试">
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!--
      后台 API 集成测试：在进程内托管真实的 ASP.NET Core 管道（路由、认证、模型绑定、控制器），
      不需要绑定端口，也不依赖任何外部服务。
    -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>

</Project>
